PORT=3052
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# TRADE_PULSE_DISABLED=true
# TRADE_PULSE_ENABLED=true
TRADE_PULSE_INITIAL_BALANCE=50000
TRADE_PULSE_VOLUME_USD=1000
TRADE_PULSE_CHECK_INTERVAL_MS=300000

# BTC は bitbank-gas のみ（既定: tradePulse では監視しない）
# TRADE_PULSE_BTC_ENABLED=true   # 有効時は bitbank btc_jpy（円建て）を参照
# TRADE_PULSE_BTC_INITIAL_BALANCE=50000
# TRADE_PULSE_BTC_VOLUME=0.0001

# 戦略（コスト抑制・利確拡大）
# TRADE_PULSE_EMA_FAST=20
# TRADE_PULSE_EMA_SLOW=50
# TRADE_PULSE_MIN_EMA_SEP_PCT=0.04
# TRADE_PULSE_RSI_BUY_MIN=42
# TRADE_PULSE_RSI_BUY_MAX=65
# TRADE_PULSE_RSI_SELL_MIN=35
# TRADE_PULSE_RSI_SELL_MAX=58
# TRADE_PULSE_STOP_LOSS_PCT=1.0
# TRADE_PULSE_TAKE_PROFIT_PCT=2.5
# TRADE_PULSE_COOLDOWN_HOURS=3
# TRADE_PULSE_ALLOW_REVERSE=false
# TRADE_PULSE_COST_JPY_PER_TRADE=30
# TRADE_PULSE_COST_USD_PER_TRADE=2

# トレンド / レンジ判定（ER=効率比, ADX=方向性, BB幅, EMAクロス回数）
# TRADE_PULSE_ER_TREND_MIN=0.32
# TRADE_PULSE_ER_RANGE_MAX=0.22
# TRADE_PULSE_ADX_TREND_MIN=22
# TRADE_PULSE_ADX_RANGE_MAX=18
# TRADE_PULSE_RANGE_RSI_BUY=32
# TRADE_PULSE_RANGE_RSI_SELL=68
# TRADE_PULSE_RANGE_STOP_LOSS_PCT=0.75
# TRADE_PULSE_RANGE_TAKE_PROFIT_PCT=1.2

# 急変判定（1H変動%以上で shock → LINEのみ、運用はSTOP想定）
# TRADE_PULSE_SHOCK_MOVE_PCT=1.5

# Saxo OpenAPI
# --- LIVE（日本口座・OAuth）---
# SAXO_API_BASE=https://gateway.saxobank.com/openapi
# SAXO_AUTH_URL=https://live.logonvalidation.net
# SAXO_APP_KEY=
# SAXO_APP_SECRET=
# SAXO_REDIRECT_URI=http://localhost:3000/saxo/callback
# SAXO_OAUTH_TOKEN_PATH=data/saxo-oauth-tokens.json
# 初回: npm run saxo:oauth:import -- --file=tokens.json
# --- SIM（24hトークン）---
# SAXO_ACCESS_TOKEN=
# SAXO_API_BASE=https://gateway.saxobank.com/sim/openapi
# SAXO_SYMBOL=EURUSD
# SAXO_ORDER_MODE=precheck
# SAXO_ORDER_AMOUNT=0
# SAXO_ASSET_TYPES=
# SAXO_ACCOUNT_KEY=
# SAXO_INSTRUMENT_UIC=
# SAXO_INSTRUMENT_ASSET_TYPE=

# G-SAXO レンジBot（暗号は G-CFX、UK100は除外）
# 既定: リーン25本（北欧4+USD/DKK+指数除外）・同時2・10万円
# GSAXO_INCLUDE_INDEX=false
# GSAXO_EXCLUDE_HEAVY_FX=true
# GSAXO_DRY_RUN=true   # 本番実発注: false
# SAXO_ACCOUNT_KEY=  # 本番サーバーは .env.server に設定（Mac から上書きされない）
# GSAXO_PAPER_JPY=200000
# GSAXO_MAX_OPEN_POSITIONS=4
# GSAXO_DAILY_STOP_COOLDOWN_HOURS=24   # 日足損切後、同一銘柄の新規を止める（0=無効）
# GSAXO_DAILY_STOP_BUFFER_PCT=0.3      # 日足H/Lからの余白%（超えてから損切）
# GSAXO_DAILY_STOP_CONFIRM_BARS=2      # 日足損切: 連続確定5分足の本数
# GSAXO_TREND_FILTER=true              # ADX+ER がともに閾値以上で新規停止
# GSAXO_ADX_PERIOD=14
# GSAXO_ADX_TREND_MIN=25              # 一般例: 25 以上でトレンド
# GSAXO_ER_PERIOD=14
# GSAXO_ER_TREND_MIN=0.30              # 一般例: 0.30 以上でトレンド
# GSAXO_TREND_PAIR_OVERRIDES=usd_cad:adx=22,er=0.28;gbp_usd:adx=22,er=0.28;usd_jpy:off
# GSAXO_TREND_AUTO=true              # 日足損切の ADX/ER から銘柄別閾値を自動調整
# GSAXO_TREND_AUTO_MIN_SAMPLES=2     # 調整開始に必要な損切サンプル数
# --- トレンドモード（F-FX式・ペーパーのみ）---
# GSAXO_TREND_MODE=true              # 日足ダウ+1H押し目の順張り（レンジと別ウォレット）
# GSAXO_TREND_PAPER_ONLY=true        # 本番稼働中もトレンドは紙のみ（既定 true）
# GSAXO_TREND_MAX_OPEN_POSITIONS=2
# GSAXO_TREND_PAPER_JPY=200000
# GSAXO_TREND_REQUIRE_FILTER_BLOCK=true  # ADX/ERでレンジ新規が止まった銘柄のみ（stopWatchOnly=false時）
# GSAXO_TREND_STOP_WATCH=true            # 日足損切後48hウォッチ→1H押し目（F-FX）
# GSAXO_TREND_STOP_WATCH_HOURS=48
# GSAXO_TREND_STOP_WATCH_ONLY=true       # true=損切ウォッチ銘柄のみエントリー
# GSAXO_TREND_OLD_RANGE_STOP=true        # 旧日足レンジ内回帰でトレンド損切
# GSAXO_SWING_STRENGTH_DAILY=15
# GSAXO_SWING_STRENGTH_1H=7
# GSAXO_TP_SPREAD_MULT=1   # 利確時に要求する最低値幅=スプレッド×此（Saxo往復コスト考慮）
# FX全30本に戻す: GSAXO_EXCLUDE_HEAVY_FX=false
# フル: 指数あり37本
# GSAXO_INCLUDE_INDEX=true
# GSAXO_EXCLUDE_HEAVY_FX=false
# GSAXO_MAX_OPEN_POSITIONS=20
# GSAXO_MAX_MARGIN_JPY_PER_PAIR=60000
# GSAXO_PAPER_JPY=500000
# GSAXO_PAIRS=xauusd,eur_usd,...(省略可)
# GSAXO_MAX_MARGIN_JPY_PER_PAIR=50000
# GSAXO_RUN_INTERVAL_MS=300000
# G-SAXO エラー通知（メール推奨 / LINE は月500通上限あり）
# --- Yahoo!メール（日本）---
# GSAXO_ALERT_EMAIL=your@yahoo.co.jp
# SMTP_HOST=smtp.mail.yahoo.co.jp
# SMTP_PORT=587
# SMTP_USER=your@yahoo.co.jp
# SMTP_PASS=（Yahooアプリパスワード）
# SMTP_FROM=G-SAXO <your@yahoo.co.jp>
# GSAXO_EMAIL_ALERT=true
# GSAXO_LINE_ALERT=false
# GSAXO_ALERT_COOLDOWN_MS=1800000
# G-SAXO META（メタ層 GAS ウェブアプリ — Google Cloud 不要）
# GSAXO_META_WEBAPP_URL=https://script.google.com/macros/s/xxxx/exec
# GSAXO_META_SECRET=（メタ層メニュー「14. G-SAXO META共有鍵設定」と同じ文字列）
# GSAXO_META_LEAGUE_AUTO=true   # META_リーグ調整を自動適用（既定 true）
