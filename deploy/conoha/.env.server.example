# サーバー専用設定（/opt/tradePulseNode/.env.server）
# Mac からは同期しない。deploy/conoha/enable-live-env.sh で生成・更新。
#
#   cd /opt/tradePulseNode && bash deploy/conoha/enable-live-env.sh

SAXO_ACCOUNT_KEY=CHowgQPhFuNoHNklja5kqQ==
GSAXO_DRY_RUN=false
GSAXO_INCLUDE_INDEX=false
GSAXO_EXCLUDE_HEAVY_FX=true
GSAXO_PAPER_JPY=200000
GSAXO_MAX_OPEN_POSITIONS=4
GSAXO_DAILY_STOP_COOLDOWN_HOURS=24
GSAXO_TREND_FILTER=true
GSAXO_ADX_PERIOD=14
GSAXO_ADX_TREND_MIN=25
GSAXO_ER_PERIOD=14
GSAXO_ER_TREND_MIN=0.30
GSAXO_TREND_AUTO=true

# トレンドモード（F-FX式・ペーパーのみ。本番レンジと並行可）
# GSAXO_TREND_MODE=true
# GSAXO_TREND_PAPER_ONLY=true
# GSAXO_TREND_MAX_OPEN_POSITIONS=2
# GSAXO_TREND_PAPER_JPY=200000
# GSAXO_TREND_REQUIRE_FILTER_BLOCK=true

# 銘柄別 ADX/ER（手動。指定時は自動調整より優先）
# GSAXO_TREND_PAIR_OVERRIDES=usd_cad:adx=22,er=0.28;gbp_usd:adx=22,er=0.28
# SMTP_PORT=465
# SMTP_SECURE=true
